# ================= الإعدادات الأمنية =================
BOT_TOKEN = os.environ.get("BOT_TOKEN")
CHANNEL_USERNAME = "@Syclickchannel"
ADMIN_CHAT_ID = int(os.environ.get("ADMIN_CHAT_ID", 0))
# ====================================================

bot = telebot.TeleBot(BOT_TOKEN)

def get_db_connection():
    if DATABASE_URL:
        db_url = DATABASE_URL
        if db_url.startswith("postgres://"):
            db_url = db_url.replace("postgres://", "postgresql://", 1)
        return psycopg2.connect(db_url)
    else:
        import sqlite3
        return sqlite3.connect('database.db')

def init_db():
    conn = get_db_connection()
    cursor = conn.cursor()
    
    if DATABASE_URL:
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id BIGINT PRIMARY KEY,
                username TEXT,
                points BIGINT DEFAULT 0,
                referrer_id BIGINT DEFAULT 0,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS withdraw_requests (
                id SERIAL PRIMARY KEY,
                user_id BIGINT,
                amount BIGINT,
                method TEXT,
                details TEXT,
                status TEXT DEFAULT 'pending'
            )
        ''')
        # إضافة عمود حماية القناة بدون حذف البيانات الحالية
        try:
            cursor.execute("ALTER TABLE users ADD COLUMN channel_joined BOOLEAN DEFAULT FALSE")
        except Exception:
            conn.rollback() # العمود موجود مسبقاً
    else:
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                points INTEGER DEFAULT 0,
                referrer_id INTEGER DEFAULT 0,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS withdraw_requests (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                amount INTEGER,
                method TEXT,
                details TEXT,
                status TEXT DEFAULT 'pending'
            )
        ''')
        try:
            cursor.execute("ALTER TABLE users ADD COLUMN channel_joined BOOLEAN DEFAULT 0")
        except Exception:
            pass

    conn.commit()
    cursor.close()
    conn.close()

init_db()

def get_user(user_id, username=""):
    conn = get_db_connection()
    cursor = conn.cursor()
    param = "%s" if DATABASE_URL else "?"
    cursor.execute(f"SELECT points, referrer_id FROM users WHERE user_id = {param}", (user_id,))
    row = cursor.fetchone()
    if not row:
        cursor.execute(f"INSERT INTO users (user_id, username, points) VALUES ({param}, {param}, 0)", (user_id, username))
        conn.commit()
        row = (0, 0)
    cursor.close()
    conn.close()
    return row

def update_user_balance(user_id, points_delta=0):
    conn = get_db_connection()
    cursor = conn.cursor()
    param = "%s" if DATABASE_URL else "?"
    cursor.execute(f"UPDATE users SET points = points + {param} WHERE user_id = {param}", (points_delta, user_id))
    conn.commit()
    cursor.close()
    conn.close()

def main_keyboard():
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=1)
    webapp_url = "https://seemamuhanna2-bit.github.io/Syclick/"
    btn_webapp = types.KeyboardButton(text="🚀 فتح منصة SyClick", web_app=types.WebAppInfo(url=webapp_url))
    markup.add(btn_webapp)
    return markup

@bot.message_handler(commands=['start'])
def start_cmd(message):
    user_id = message.chat.id
    username = message.from_user.username or message.from_user.first_name or "بدون اسم"
    
    args = message.text.split()
    referrer_id = 0
    if len(args) > 1 and args[1].isdigit():
        referrer_id = int(args[1])
        
    conn = get_db_connection()
    cursor = conn.cursor()
    param = "%s" if DATABASE_URL else "?"
    
    cursor.execute(f"SELECT points, referrer_id FROM users WHERE user_id = {param}", (user_id,))
    row = cursor.fetchone()
    
    if not row:
        # تسجيل المستخدم مع حفظ كود الإحالة بدون إعطاء نقاط حالياً
        if referrer_id == user_id:
            referrer_id = 0
            
        cursor.execute(f"INSERT INTO users (user_id, username, points, referrer_id) VALUES ({param}, {param}, 0, {param})", (user_id, username, referrer_id))
        conn.commit()
        points = 0
    else:
        points = row[0]
        # إذا كان المستخدم قديماً ودخل من رابط ولم يكن لديه مُحيل مسبق
        if referrer_id != 0 and referrer_id != user_id and (row[1] == 0 or row[1] is None):
            cursor.execute(f"UPDATE users SET referrer_id = {param} WHERE user_id = {param}", (referrer_id, user_id))
            conn.commit()
                
    cursor.close()
    conn.close()
    
    text = (
        "🚀 **أهلاً بك في منصة SyClick** 🚀\n\n"
        "المنصة التفاعلية لتنفيذ مهام التأهيل وجمع النقاط والانطلاق بالعمل الرقمي.\n\n"
        f"💎 رصيدك الحالي في السيرفر: **{points:,}** نقطة\n\n"
        "اضغط على الزر أدناه لفتح المنصة والبدء 👇"
    )
    bot.send_message(user_id, text, reply_markup=main_keyboard(), parse_mode="Markdown")

@bot.message_handler(commands=['admin', 'stats'])
def admin_cmd(message):
    if message.chat.id != ADMIN_CHAT_ID:
        return

    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*), COALESCE(SUM(points), 0) FROM users")
    total_users, total_points = cursor.fetchone()
    cursor.execute("SELECT user_id, username, points FROM users ORDER BY points DESC LIMIT 5")
    top_players = cursor.fetchall()
    cursor.execute("SELECT COUNT(*) FROM withdraw_requests WHERE status = 'pending'")
    pending_withdrawals = cursor.fetchone()[0]
    cursor.close()
    conn.close()

    report = (
        "📊 **لوحة تحكم إدارة SyClick** 📊\n\n"
        f"👥 **إجمالي المسجلين:** {total_users:,} لاعب\n"
        f"💰 **إجمالي النقاط المسجلة:** {total_points:,} نقطة\n"
        f"⏳ **طلبات السحب المعلقة:** {pending_withdrawals}\n\n"
        "🏆 **أعلى 5 متصدرين حالياً:**\n"
    )

    for idx, p in enumerate(top_players, 1):
        uname = f"@{p[1]}" if p[1] and p[1] != "بدون اسم" else f"`{p[0]}`"
        report += f"{idx}. {uname} ➔ **{p[2]:,}** نقطة\n"

    report += "\n_💡 أرسل أمر /users لعرض كل المستخدمين بالتفصيل._"
    bot.send_message(message.chat.id, report, parse_mode="Markdown")

@bot.message_handler(commands=['users'])
def admin_users_cmd(message):
    if message.chat.id != ADMIN_CHAT_ID:
        return

    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT user_id, username, points FROM users ORDER BY points DESC")
    all_users = cursor.fetchall()
    cursor.close()
    conn.close()

    if not all_users:
        bot.send_message(message.chat.id, "لا يوجد مستخدمين بعد.")
        return

    report = "📋 **قائمة كل اللاعبين والنقاط:**\n\n"
    for idx, p in enumerate(all_users, 1):
        uname = p[1] if p[1] else "بدون اسم"
        line = f"{idx}. {uname} (`{p[0]}`) ➔ {p[2]:,} نقطة\n"
        
        if len(report) + len(line) > 3800:
            bot.send_message(message.chat.id, report, parse_mode="Markdown")
            report = ""
        report += line

    if report:
        bot.send_message(message.chat.id, report, parse_mode="Markdown")

@bot.message_handler(content_types=['web_app_data'])
def handle_web_app_data(message):
    data_str = message.web_app_data.data
    user_id = message.from_user.id
    username = message.from_user.username or message.from_user.first_name or "بدون اسم"
    
    try:
        data = json.loads(data_str)
    except Exception:
        data = {"action": data_str}

    action = data.get("action")

    # 1. الانضمام للقناة مع سد ثغرة التكرار
    if action == 'verify_channel':
        conn = get_db_connection()
        cursor = conn.cursor()
        param = "%s" if DATABASE_URL else "?"
        
        cursor.execute(f"SELECT channel_joined FROM users WHERE user_id = {param}", (user_id,))
        row = cursor.fetchone()
        
        # إذا لم يكن مسجلاً، نقوم بإنشاء سجل له
        if not row:
            cursor.execute(f"INSERT INTO users (user_id, username, points) VALUES ({param}, {param}, 0)", (user_id, username))
            conn.commit()
            already_joined = False
        else:
            already_joined = row[0]
            
        if already_joined:
            bot.send_message(user_id, "⚠️ **لقد حصلت على مكافأة الانضمام للقناة مسبقاً!**")
        else:
            try:
                member = bot.get_chat_member(CHANNEL_USERNAME, user_id)
                if member.status in ['member', 'administrator', 'creator']:
                    cursor.execute(f"UPDATE users SET points = points + 10, channel_joined = TRUE WHERE user_id = {param}", (user_id,))
                    conn.commit()
                    bot.send_message(user_id, "✅ **تم التحقق!** شكراً لانضمامك للقناة، تمت إضافة **10 نقاط** لرصيدك.", parse_mode="Markdown")
                else:
                    bot.send_message(user_id, f"❌ **لم تقم بالانضمام بعد!** يرجى الانضمام للقناة أولاً:\n{CHANNEL_USERNAME}", parse_mode="Markdown")
            except Exception as e:
                bot.send_message(user_id, f"⚠️ **عذراً:** يرجى التأكد من انضمامك للقناة أولاً {CHANNEL_USERNAME} \n(تأكد أيضاً من رفع البوت كأدمن في القناة)", parse_mode="Markdown")
        
        cursor.close()
        conn.close()

    # 2. حفظ النقاط ومعالجة نظام الإحالة الآمن
    elif action == 'save_points':
        new_points = data.get("points", 0)
        
        # حماية من الأرقام الخيالية (أكثر من 150 ألف نقطة تعتبر تلاعباً)
        if new_points < 0 or new_points > 150000:
            bot.send_message(user_id, "❌ خطأ في مزامنة البيانات، يرجى المحاولة لاحقاً.")
            return

        conn = get_db_connection()
        cursor = conn.cursor()
        param = "%s" if DATABASE_URL else "?"
        
        # تحديث رصيد اللاعب
        cursor.execute(f"UPDATE users SET points = {param} WHERE user_id = {param}", (new_points, user_id))
        
        # فحص الإحالة: هل تجاوز 100 نقطة ولديه مُحيل؟
        cursor.execute(f"SELECT referrer_id FROM users WHERE user_id = {param}", (user_id,))
        referrer_row = cursor.fetchone()
        
        if referrer_row and referrer_row[0] != 0:
            referrer_id = referrer_row[0]
            if new_points >= 100:
                # إعطاء الجائزة للمُحيل
                cursor.execute(f"UPDATE users SET points = points + 100 WHERE user_id = {param}", (referrer_id,))
                # مسح الإحالة لسد الثغرة
                cursor.execute(f"UPDATE users SET referrer_id = 0 WHERE user_id = {param}", (user_id,))
                try:
                    bot.send_message(referrer_id, f"🎉 **مبروك!** صديقك الذي دعوته أتم 100 نقطة، وحصلت أنت على **100 نقطة** مكافأة الإحالة!", parse_mode="Markdown")
                except Exception:
                    pass

        conn.commit()
        cursor.close()
        conn.close()
        bot.send_message(user_id, f"💾 **تم حفظ تقدمك بنجاح!**\nرصيدك الآن في السيرفر أصبح: **{new_points:,}** نقطة.", parse_mode="Markdown")

    # 3. معالجة طلب سحب الأرباح
    elif action == 'withdraw':
        user_data = get_user(user_id, username)
        current_points = user_data[0]
        
        method_names = {
            "sham_cash": "شام كاش",
            "haram": "شركة الهرم",
            "fouad": "شركة الفؤاد"
        }
        method = method_names.get(data.get("method"), data.get("method", "محلي"))
        details = data.get("details", "لا توجد تفاصيل")

        if current_points >= 50000:
            conn = get_db_connection()
            cursor = conn.cursor()
            param = "%s" if DATABASE_URL else "?"
            cursor.execute(f"INSERT INTO withdraw_requests (user_id, amount, method, details) VALUES ({param}, {param}, {param}, {param})",
                           (user_id, current_points, method, details))
            cursor.execute(f"UPDATE users SET points = 0 WHERE user_id = {param}", (user_id,))
            conn.commit()
            cursor.close()
            conn.close()

            bot.send_message(
                user_id,
                f"✅ **تم تسجيل طلبك بنجاح!**\n\n"
                f"💰 النقاط المحولة: {current_points:,} نقطة\n"
                f"🏦 وسيلة الاستلام: {method}\n"
                f"📝 البيانات المسجلة: `{details}`\n\n"
                "سيتم مراجعة إتمام مرحلة التأهيل والتواصل معك قريباً.",
                parse_mode="Markdown"
            )

            if ADMIN_CHAT_ID != 0:
                try:
                    admin_text = (
                        "🚨 **طلب تأهيل وسحب جديد في SyClick!**\n\n"
                        f"👤 المستخدم: @{username} (`{user_id}`)\n"
                        f"💰 النقاط: {current_points:,}\n"
                        f"🏦 وسيلة السحب: {method}\n"
                        f"📋 بيانات التحويل: `{details}`"
                    )
                    bot.send_message(ADMIN_CHAT_ID, admin_text, parse_mode="Markdown")
                except Exception as e:
                    pass
        else:
            bot.send_message(user_id, f"❌ رصيدك الحالي في السيرفر ({current_points:,} نقطة) أقل من الحد الأدنى المطلوب للتأهيل (50,000 نقطة).")

if __name__ == '__main__':
    keep_alive()
    bot.infinity_polling()
