def get_db_connection():
    if DATABASE_URL:
        db_url = DATABASE_URL
        if db_url.startswith("postgres://"):
            db_url = db_url.replace("postgres://", "postgresql://", 1)
        return psycopg2.connect(db_url)
    else:
        import sqlite3
        return sqlite3.connect('database.db')

def init_db():
    conn = get_db_connection()
    cursor = conn.cursor()
    
    if DATABASE_URL:
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id BIGINT PRIMARY KEY,
                username TEXT,
                points BIGINT DEFAULT 0,
                energy BIGINT DEFAULT 1000,
                referrer_id BIGINT DEFAULT 0,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                channel_joined BOOLEAN DEFAULT FALSE
            )
        ''')
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS withdraw_requests (
                id SERIAL PRIMARY KEY,
                user_id BIGINT,
                amount BIGINT,
                method TEXT,
                details TEXT,
                status TEXT DEFAULT 'pending'
            )
        ''')
        try:
            cursor.execute("ALTER TABLE users ADD COLUMN energy BIGINT DEFAULT 1000")
        except Exception:
            pass
        try:
            cursor.execute("ALTER TABLE users ADD COLUMN channel_joined BOOLEAN DEFAULT FALSE")
        except Exception:
            pass
    else:
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                points INTEGER DEFAULT 0,
                energy INTEGER DEFAULT 1000,
                referrer_id INTEGER DEFAULT 0,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                channel_joined BOOLEAN DEFAULT 0
            )
        ''')
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS withdraw_requests (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                amount INTEGER,
                method TEXT,
                details TEXT,
                status TEXT DEFAULT 'pending'
            )
        ''')
        try:
            cursor.execute("ALTER TABLE users ADD COLUMN energy INTEGER DEFAULT 1000")
        except Exception:
            pass
        try:
            cursor.execute("ALTER TABLE users ADD COLUMN channel_joined BOOLEAN DEFAULT 0")
        except Exception:
            pass

    conn.commit()
    cursor.close()
    conn.close()

init_db()

def get_user(user_id, username=""):
    conn = get_db_connection()
    cursor = conn.cursor()
    param = "%s" if DATABASE_URL else "?"
    cursor.execute(f"SELECT points, referrer_id, energy FROM users WHERE user_id = {param}", (user_id,))
    row = cursor.fetchone()
    if not row:
        cursor.execute(f"INSERT INTO users (user_id, username, points, energy) VALUES ({param}, {param}, 0, 1000)", (user_id, username))
        conn.commit()
        row = (0, 0, 1000)
    cursor.close()
    conn.close()
    return row

def update_user_balance(user_id, points_delta=0, energy_delta=0):
    conn = get_db_connection()
    cursor = conn.cursor()
    param = "%s" if DATABASE_URL else "?"
    cursor.execute(f"UPDATE users SET points = points + {param}, energy = energy + {param} WHERE user_id = {param}", (points_delta, energy_delta, user_id))
    conn.commit()
    cursor.close()
    conn.close()

