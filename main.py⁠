bot = telebot.TeleBot(BOT_TOKEN)

# دالة فتح الاتصال بقاعدة البيانات المناسبة
def get_db_connection():
    if DATABASE_URL:
        db_url = DATABASE_URL
        if db_url.startswith("postgres://"):
            db_url = db_url.replace("postgres://", "postgresql://", 1)
        return psycopg2.connect(db_url)
    else:
        import sqlite3
        return sqlite3.connect('database.db')

# تجهيز جداول قاعدة البيانات
def init_db():
    conn = get_db_connection()
    cursor = conn.cursor()
    
    if DATABASE_URL:
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id BIGINT PRIMARY KEY,
                username TEXT,
                points BIGINT DEFAULT 0,
                referrer_id BIGINT DEFAULT 0,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS withdraw_requests (
                id SERIAL PRIMARY KEY,
                user_id BIGINT,
                amount BIGINT,
                method TEXT,
                details TEXT,
                status TEXT DEFAULT 'pending'
            )
        ''')
    else:
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                points INTEGER DEFAULT 0,
                referrer_id INTEGER DEFAULT 0,
                joined_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS withdraw_requests (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                amount INTEGER,
                method TEXT,
                details TEXT,
                status TEXT DEFAULT 'pending'
            )
        ''')
        
    conn.commit()
    cursor.close()
    conn.close()

init_db()

def get_user(user_id, username=""):
    conn = get_db_connection()
    cursor = conn.cursor()
    param = "%s" if DATABASE_URL else "?"
    cursor.execute(f"SELECT points FROM users WHERE user_id = {param}", (user_id,))
    row = cursor.fetchone()
    if not row:
        cursor.execute(f"INSERT INTO users (user_id, username, points) VALUES ({param}, {param}, 0)", (user_id, username))
        conn.commit()
        row = (0,)
    cursor.close()
    conn.close()
    return row

def update_user_balance(user_id, points_delta=0):
    conn = get_db_connection()
    cursor = conn.cursor()
    param = "%s" if DATABASE_URL else "?"
    cursor.execute(f"UPDATE users SET points = points + {param} WHERE user_id = {param}", (points_delta, user_id))
    conn.commit()
    cursor.close()
    conn.close()

