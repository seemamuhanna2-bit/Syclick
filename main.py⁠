        member = bot.get_chat_member(CHANNEL_USERNAME, user_id)
        if member.status in ['member', 'administrator', 'creator']:
            conn = sqlite3.connect('database.db')
            cursor = conn.cursor()
            cursor.execute("UPDATE users SET points = points + 50, joined_channel = 1 WHERE user_id = ?", (user_id,))
            conn.commit()
            conn.close()
            bot.send_message(user_id, "🎉 أحسنت! تم التحقق من اشتراكك بنجاح وتمت إضافة 50 نقطة 💎 إلى رصيدك!")
