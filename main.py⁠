@bot.message_handler(commands=['start'])
def start_cmd(message):
    user_id = message.chat.id
    username = message.from_user.username or message.from_user.first_name or "بدون اسم"
    
    args = message.text.split()
    referrer_id = 0
    if len(args) > 1 and args[1].isdigit():
        referrer_id = int(args[1])
        
    conn = get_db_connection()
    cursor = conn.cursor()
    param = "%s" if DATABASE_URL else "?"
    
    cursor.execute(f"SELECT points, referrer_id, energy FROM users WHERE user_id = {param}", (user_id,))
    row = cursor.fetchone()
    
    if not row:
        if referrer_id == user_id:
            referrer_id = 0
        cursor.execute(f"INSERT INTO users (user_id, username, points, energy, referrer_id) VALUES ({param}, {param}, 0, 1000, {param})", (user_id, username, referrer_id))
        conn.commit()
        points = 0
        energy = 1000
    else:
        points = row[0]
        energy = row[2]
        if referrer_id != 0 and referrer_id != user_id and (row[1] == 0 or row[1] is None):
            cursor.execute(f"UPDATE users SET referrer_id = {param} WHERE user_id = {param}", (referrer_id, user_id))
            conn.commit()
                
    cursor.close()
    conn.close()
    
    text = (
        "🚀 **أهلاً بك في منصة SyClick** 🚀\n\n"
        "المنصة التفاعلية لتنفيذ مهام التأهيل وجمع النقاط والانطلاق بالعمل الرقمي.\n\n"
        f"💎 رصيدك الحالي: **{points:,}** نقطة\n"
        f"⚡️ طاقتك الحالية: **{energy:,}** طاقة\n\n"
        "اختر من القائمة أدناه 👇"
    )
    bot.send_message(user_id, text, reply_markup=main_keyboard(), parse_mode="Markdown")

@bot.message_handler(commands=['admin', 'stats'])
def admin_cmd(message):
    if message.chat.id != ADMIN_CHAT_ID:
        return

    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*), COALESCE(SUM(points), 0) FROM users")
    total_users, total_points = cursor.fetchone()
    cursor.execute("SELECT user_id, username, points FROM users ORDER BY points DESC LIMIT 5")
    top_players = cursor.fetchall()
    cursor.execute("SELECT COUNT(*) FROM withdraw_requests WHERE status = 'pending'")
    pending_withdrawals = cursor.fetchone()[0]
    cursor.close()
    conn.close()

    report = (
        "📊 **لوحة تحكم إدارة SyClick** 📊\n\n"
        f"👥 **إجمالي المسجلين:** {total_users:,} لاعب\n"
        f"💰 **إجمالي النقاط المسجلة:** {total_points:,} نقطة\n"
        f"⏳ **طلبات السحب المعلقة:** {pending_withdrawals}\n\n"
        "🏆 **أعلى 5 متصدرين حالياً:**\n"
    )
    for idx, p in enumerate(top_players, 1):
        uname = f"@{p[1]}" if p[1] and p[1] != "بدون اسم" else f"`{p[0]}`"
        report += f"{idx}. {uname} ➔ **{p[2]:,}** نقطة\n"

    report += "\n_💡 أرسل أمر /users لعرض كل المستخدمين بالتفصيل._"
    bot.send_message(message.chat.id, report, parse_mode="Markdown")

@bot.message_handler(commands=['users'])
def admin_users_cmd(message):
    if message.chat.id != ADMIN_CHAT_ID:
        return

    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT user_id, username, points FROM users ORDER BY points DESC")
    all_users = cursor.fetchall()
    cursor.close()
    conn.close()

    if not all_users:
        bot.send_message(message.chat.id, "لا يوجد مستخدمين بعد.")
        return

    report = "📋 **قائمة كل اللاعبين والنقاط:**\n\n"
    for idx, p in enumerate(all_users, 1):
        uname = p[1] if p[1] else "بدون اسم"
        line = f"{idx}. {uname} (`{p[0]}`) ➔ {p[2]:,} نقطة\n"
        if len(report) + len(line) > 3800:
            bot.send_message(message.chat.id, report, parse_mode="Markdown")
            report = ""
        report += line

    if report:
        bot.send_message(message.chat.id, report, parse_mode="Markdown")

