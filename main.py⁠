# دعم كل من SQLite محلياً و PostgreSQL سحابياً لضمان حفظ البيانات
DATABASE_URL = os.environ.get("DATABASE_URL")
if DATABASE_URL:
    import psycopg2

# خادم الويب لإبقاء البوت نشطاً على Render
app = Flask('')

