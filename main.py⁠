    btn_captcha = types.KeyboardButton("🧩 حل كابتشا (+2 💎)")
    btn_energy = types.KeyboardButton("⚡ شحن الطاقة")
    btn_invite = types.KeyboardButton("👥 دعوة أصدقاء (+100 💎)")
    btn_balance = types.KeyboardButton("💰 رصيدي ومحفظتي")
    markup.add(btn_tasks)
    markup.add(btn_channel, btn_captcha)
    markup.add(btn_energy, btn_invite)
    markup.add(btn_balance)
    return markup

