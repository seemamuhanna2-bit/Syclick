    except Exception:
        bot.send_message(user_id, f"يرجى التأكد من الانضمام لقناتنا الرسمية: {CHANNEL_USERNAME}")

# نظام الكابتشا وشحن الطاقة
@bot.message_handler(func=lambda m: m.text in ["🧩 حل كابتشا (+2 💎)", "⚡ شحن الطاقة"])
def send_captcha_challenge(message):
    user_id = message.chat.id
    # توليد كود كابتشا تحقق ذكي وسريع
    code = ''.join(random.choices(string.ascii_uppercase + string.digits, k=5))
    user_captcha_challenges[user_id] = code
    
    bot.send_message(
        user_id,
        f"🧩 **رمز التحقق (الكابتشا):**\n\n"
        f"`{code}`\n\n"
        "✍️ اكتب الرمز الظاهر أعلاه وأرسله في المحادثة لكسب **2 نقطة 💎** وشحن **1 طاقة ⚡**:",
        parse_mode="Markdown"
    )

# استقبال حل الكابتشا من المستخدم
@bot.message_handler(func=lambda m: m.chat.id in user_captcha_challenges)
def verify_captcha_solution(message):
    user_id = message.chat.id
    expected = user_captcha_challenges.get(user_id)
    user_input = message.text.strip().upper()

    if user_input == expected:
        del user_captcha_challenges[user_id]
        update_user_balance(user_id, points_delta=2, energy_delta=1)
        user = get_user(user_id)
        bot.send_message(
            user_id,
            f"🎉 **إجابة صحيحة!**\n\n"
            f"+2 نقطة 💎 تمت إضافتها لرصيدك.\n"
            f"+1 طاقة ⚡ تم شحنها.\n\n"
            f"💎 رصيدك الآن: {user[0]} نقطة\n"
            f"⚡ طاقتك الآن: {user[1]}",
            parse_mode="Markdown"
        )
    else:
        bot.send_message(user_id, "❌ الرمز غير صحيح. حاول مرة أخرى أو اطلب كابتشا جديدة من القائمة.")

