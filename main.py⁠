# ================= الإعدادات =================
BOT_TOKEN = os.environ.get("BOT_TOKEN")
CHANNEL_USERNAME = "@Syclickchannel"
# ============================================

bot = telebot.TeleBot(BOT_TOKEN)

# تجهيز قاعدة البيانات
def init_db():
    conn = sqlite3.connect('database.db')
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            points INTEGER DEFAULT 0,
            referrer_id INTEGER DEFAULT 0
        )
    ''')
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS withdraw_requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            amount INTEGER,
            method TEXT,
            details TEXT,
            status TEXT DEFAULT 'pending'
        )
    ''')
    conn.commit()
    conn.close()

init_db()

def get_user(user_id):
    conn = sqlite3.connect('database.db')
    cursor = conn.cursor()
    cursor.execute("SELECT points FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    if not row:
        cursor.execute("INSERT INTO users (user_id, points) VALUES (?, 0)", (user_id,))
        conn.commit()
        row = (0,)
    conn.close()
    return row

def update_user_balance(user_id, points_delta=0):
    conn = sqlite3.connect('database.db')
    cursor = conn.cursor()
    cursor.execute("UPDATE users SET points = points + ? WHERE user_id = ?", (points_delta, user_id))
    conn.commit()
    conn.close()

# لوحة مفاتيح فتح التطبيق المصغر
def main_keyboard():
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=1)
    webapp_url = "https://seemamuhanna2-bit.github.io/Syclick/"
    btn_webapp = types.KeyboardButton(text="🚀 فتح منصة SyClick", web_app=types.WebAppInfo(url=webapp_url))
    markup.add(btn_webapp)
    return markup

@bot.message_handler(commands=['start'])
def start_cmd(message):
    user_id = message.chat.id
    user = get_user(user_id)
    text = (
        "🚀 **أهلاً بك في منصة SyClick** 🚀\n\n"
        "منصتك الموثوقة لتنفيذ المهام وتجميع الأرباح والسحب محلياً.\n\n"
        f"💎 رصيدك الحالي: **{user[0]}** نقطة\n\n"
        "اضغط على الزر أدناه لفتح المنصة، تدوير عجلة الحظ، وتنفيذ المهام 👇"
    )
    bot.send_message(user_id, text, reply_markup=main_keyboard(), parse_mode="Markdown")

# استقبال البيانات من تطبيق الويب المصغر (Mini App)
@bot.message_handler(content_types=['web_app_data'])
def handle_web_app_data(message):
    data_str = message.web_app_data.data
    user_id = message.from_user.id
    user_data = get_user(user_id)
    points = user_data[0]

    # محاولة قراءة البيانات بصيغة JSON لعمليات السحب المعقدة
    try:
        data = json.loads(data_str)
    except Exception:
        data = {"action": data_str}

    action = data.get("action")

    if action == 'withdraw':
        method_names = {
            "sham_cash": "شام كاش",
            "haram": "شركة الهرم",
            "fouad": "شركة الفؤاد"
        }
        method = method_names.get(data.get("method"), data.get("method", "محلي"))
        details = data.get("details", "لا توجد تفاصيل")

        if points >= 10000:
            conn = sqlite3.connect('database.db')
            cursor = conn.cursor()
            # تسجيل طلب السحب وخصم النقاط
            cursor.execute("INSERT INTO withdraw_requests (user_id, amount, method, details) VALUES (?, ?, ?, ?)",
                           (user_id, points, method, details))
            cursor.execute("UPDATE users SET points = 0 WHERE user_id = ?", (user_id,))
            conn.commit()
            conn.close()

            bot.send_message(
                user_id,
                f"✅ **تم تسجيل طلب السحب بنجاح!**\n\n"
                f"💰 المبلغ: {points} نقطة\n"
                f"🏦 الوسيلة: {method}\n"
                f"📝 البيانات: `{details}`\n\n"
                "سيتم مراجعة الطلب وتحويل المبلغ قريباً عبر الإشراف المباشر.",
                parse_mode="Markdown"
            )
        else:
            bot.send_message(user_id, f"❌ رصيدك الحالي ({points} نقطة) أقل من الحد الأدنى للسحب (10,000 نقطة).")

    elif action == 'invite':
        bot_info = bot.get_me()
        bot.send_message(
            user_id,
            f"🔗 **رابط الدعوة الخاص بك:**\n"
            f"https://t.me/{bot_info.username}?start={user_id}\n\n"
            "انسخ الرابط وشاركه؛ ستحصل على مكافأة فورية عند انضمام وتفاعل أصدقائك!"
        )

if __name__ == '__main__':
    keep_alive()
    bot.infinity_polling()
