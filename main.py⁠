import os
import json
from flask import Flask
from threading import Thread
import telebot
from telebot import types
import sqlite3

# خادم الويب لإبقاء البوت نشطاً على منصة Render
app = Flask('')

@app.route('/')
def home():
    return "SyClick Bot is Active!"

def run_web():
    port = int(os.environ.get('PORT', 10000))
    app.run(host='0.0.0.0', port=port)

def keep_alive():
