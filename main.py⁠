# استقبال البيانات والأوامر من التطبيق المصغر (Mini App)
@bot.message_handler(content_types=['web_app_data'])
def handle_web_app_data(message):
    data_str = message.web_app_data.data
    user_id = message.from_user.id
    username = message.from_user.username or message.from_user.first_name or "بدون اسم"
    user_data = get_user(user_id, username)
    points = user_data[0]

    try:
        data = json.loads(data_str)
    except Exception:
        data = {"action": data_str}

    action = data.get("action")

    # معالجة طلب سحب الأرباح
    if action == 'withdraw':
        method_names = {
            "sham_cash": "شام كاش",
            "haram": "شركة الهرم",
            "fouad": "شركة الفؤاد"
        }
        method = method_names.get(data.get("method"), data.get("method", "محلي"))
        details = data.get("details", "لا توجد تفاصيل")

        if points >= 50000:
            conn = get_db_connection()
            cursor = conn.cursor()
            param = "%s" if DATABASE_URL else "?"
            cursor.execute(f"INSERT INTO withdraw_requests (user_id, amount, method, details) VALUES ({param}, {param}, {param}, {param})",
                           (user_id, points, method, details))
            cursor.execute(f"UPDATE users SET points = 0 WHERE user_id = {param}", (user_id,))
            conn.commit()
            cursor.close()
            conn.close()

            # إشعار للمستخدم
            bot.send_message(
                user_id,
                f"✅ **تم تسجيل طلبك بنجاح!**\n\n"
                f"💰 النقاط المحولة: {points:,} نقطة\n"
                f"🏦 وسيلة الاستلام: {method}\n"
                f"📝 البيانات المسجلة: `{details}`\n\n"
                "سيتم مراجعة إتمام مرحلة التأهيل والتواصل معك قريباً.",
                parse_mode="Markdown"
            )

            # إشعار مباشر للإدارة
            if ADMIN_CHAT_ID != 0:
                try:
                    admin_text = (
                        "🚨 **طلب تأهيل وسحب جديد في SyClick!**\n\n"
                        f"👤 المستخدم: @{username} (`{user_id}`)\n"
                        f"💰 النقاط: {points:,}\n"
                        f"🏦 وسيلة السحب: {method}\n"
                        f"📋 بيانات التحويل: `{details}`"
                    )
                    bot.send_message(ADMIN_CHAT_ID, admin_text, parse_mode="Markdown")
                except Exception as e:
                    print("تنبيه: لم يتمكن البوت من مراسلة المشرف:", e)
        else:
            bot.send_message(user_id, f"❌ رصيدك الحالي ({points:,} نقطة) أقل من الحد الأدنى المطلوب للتأهيل (50,000 نقطة).")

    # نسخ رابط الدعوة
    elif action == 'invite':
        bot_info = bot.get_me()
        bot.send_message(
            user_id,
            f"🔗 **رابط الدعوة الخاص بك:**\n"
            f"https://t.me/{bot_info.username}?start={user_id}\n\n"
            "شارك هذا الرابط مع أصدقائك؛ ستحصل على نقاط إضافية تؤهلك بشكل أسرع لكل صديق ينضم عبرك!"
        )

