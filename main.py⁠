@bot.message_handler(func=lambda m: m.text == "📢 الاشتراك بالقناة (+50 💎)")
def channel_cmd(message):
    user_id = message.chat.id
    user = get_user(user_id)
    if user[2] == 1:
        bot.send_message(user_id, "✅ لقد استلمت مكافأة الاشتراك مسبقاً!")
        return

    try:
        member = bot.get_chat_member(CHANNEL_USERNAME, user_id)
        if member.status in ['member', 'administrator', 'creator']:
            conn = sqlite3.connect('database.db')
            cursor = conn.cursor()
            cursor.execute("UPDATE users SET points = points + 50, joined_channel = 1 WHERE user_id = ?", (user_id,))
            conn.commit()
            conn.close()
            bot.send_message(user_id, "🎉 أحسنت! تم التحقق من اشتراكك بنجاح وإضافة 50 نقطة 💎 إلى رصيدك!")
        else:
            bot.send_message(user_id, f"⚠️ لم يتم العثور على اشتراكك بعد.\nيرجى الانضمام أولاً للقناة: {CHANNEL_USERNAME}\nثم الضغط على الزر مرة أخرى للتحقق.")
    except Exception:
        bot.send_message(user_id, f"يرجى التأكد من الانضمام للقناة: {CHANNEL_USERNAME}")

