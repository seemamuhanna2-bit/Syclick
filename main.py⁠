import os
import json
from flask import Flask
from threading import Thread
import telebot
from telebot import types
import sqlite3

# خادم الويب لإبقاء البوت نشطاً على Render
app = Flask('')

@app.route('/')
def home():
    return "SyClick Bot is Active!"

def run_web():
    port = int(os.environ.get('PORT', 10000))
    app.run(host='0.0.0.0', port=port)

def keep_alive():
    t = Thread(target=run_web)
    t.start()

# ================= الإعدادات الأمنية =================
BOT_TOKEN = os.environ.get("BOT_TOKEN")
CHANNEL_USERNAME = "@Syclickchannel"

# قراءة الآيدي بأمان من Render دون كتابته علناً في GitHub
ADMIN_CHAT_ID = int(os.environ.get("ADMIN_CHAT_ID", 0))
# ====================================================

bot = telebot.TeleBot(BOT_TOKEN)

# تجهيز قاعدة البيانات
def init_db():
    conn = sqlite3.connect('database.db')
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            points INTEGER DEFAULT 0,
            referrer_id INTEGER DEFAULT 0
        )
    ''')
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS withdraw_requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            amount INTEGER,
            method TEXT,
            details TEXT,
            status TEXT DEFAULT 'pending'
        )
    ''')
    conn.commit()
    conn.close()

init_db()

def get_user(user_id):
    conn = sqlite3.connect('database.db')
    cursor = conn.cursor()
    cursor.execute("SELECT points FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    if not row:
        cursor.execute("INSERT INTO users (user_id, points) VALUES (?, 0)", (user_id,))
        conn.commit()
        row = (0,)
    conn.close()
    return row

def update_user_balance(user_id, points_delta=0):
    conn = sqlite3.connect('database.db')
    cursor = conn.cursor()
    cursor.execute("UPDATE users SET points = points + ? WHERE user_id = ?", (points_delta, user_id))
    conn.commit()
    conn.close()

# لوحة مفاتيح تشغيل التطبيق المصغر
def main_keyboard():
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=1)
    webapp_url = "https://seemamuhanna2-bit.github.io/Syclick/"
    btn_webapp = types.KeyboardButton(text="🚀 فتح منصة SyClick", web_app=types.WebAppInfo(url=webapp_url))
    markup.add(btn_webapp)
    return markup

@bot.message_handler(commands=['start'])
def start_cmd(message):
    user_id = message.chat.id
    user = get_user(user_id)
    text = (
        "🚀 **أهلاً بك في منصة SyClick** 🚀\n\n"
        "المنصة التفاعلية للألعاب وتنفيذ المهام وجمع النقاط والسحب محلياً.\n\n"
        f"💎 رصيدك الحالي: **{user[0]:,}** نقطة\n\n"
        "اضغط على الزر أدناه لفتح المنصة والبدء باللعب 👇"
    )
    bot.send_message(user_id, text, reply_markup=main_keyboard(), parse_mode="Markdown")

# استقبال البيانات والأوامر من التطبيق المصغر (Mini App)
@bot.message_handler(content_types=['web_app_data'])
def handle_web_app_data(message):
    data_str = message.web_app_data.data
    user_id = message.from_user.id
    user_data = get_user(user_id)
    points = user_data[0]

    try:
        data = json.loads(data_str)
    except Exception:
        data = {"action": data_str}

    action = data.get("action")

    # معالجة طلب سحب الأرباح
    if action == 'withdraw':
        method_names = {
            "sham_cash": "شام كاش",
            "haram": "شركة الهرم",
            "fouad": "شركة الفؤاد"
        }
        method = method_names.get(data.get("method"), data.get("method", "محلي"))
        details = data.get("details", "لا توجد تفاصيل")

        if points >= 50000:
            conn = sqlite3.connect('database.db')
            cursor = conn.cursor()
            cursor.execute("INSERT INTO withdraw_requests (user_id, amount, method, details) VALUES (?, ?, ?, ?)",
                           (user_id, points, method, details))
            cursor.execute("UPDATE users SET points = 0 WHERE user_id = ?", (user_id,))
            conn.commit()
            conn.close()

            # إشعار للمستخدم
            bot.send_message(
                user_id,
                f"✅ **تم تسجيل طلب السحب بنجاح!**\n\n"
                f"💰 المبلغ المسحوب: {points:,} نقطة\n"
                f"🏦 وسيلة الاستلام: {method}\n"
                f"📝 البيانات المسجلة: `{details}`\n\n"
                "سيتم مراجعة الطلب وتحويل المبلغ خلال وقت قصير.",
                parse_mode="Markdown"
            )

            # إشعار مباشر للإدارة
            if ADMIN_CHAT_ID != 0:
                try:
                    admin_text = (
                        "🚨 **طلب سحب جديد في SyClick!**\n\n"
                        f"👤 آيدي المستخدم: `{user_id}`\n"
                        f"💰 المبلغ: {points:,} نقطة\n"
                        f"🏦 وسيلة السحب: {method}\n"
                        f"📋 بيانات التحويل: `{details}`"
                    )
                    bot.send_message(ADMIN_CHAT_ID, admin_text, parse_mode="Markdown")
                except Exception as e:
                    print("تنبيه: لم يتمكن البوت من مراسلة المشرف:", e)
        else:
            bot.send_message(user_id, f"❌ رصيدك الحالي ({points:,} نقطة) أقل من الحد الأدنى للسحب (50,000 نقطة).")

    # نسخ رابط الدعوة
    elif action == 'invite':
        bot_info = bot.get_me()
        bot.send_message(
            user_id,
            f"🔗 **رابط الدعوة الخاص بك:**\n"
            f"https://t.me/{bot_info.username}?start={user_id}\n\n"
            "شارك هذا الرابط مع أصدقائك؛ ستحصل على مكافأة لكل مستخدم ينضم ويتفاعل عبرك!"
        )

if __name__ == '__main__':
    keep_alive()
    bot.infinity_polling()
