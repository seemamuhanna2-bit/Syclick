    cursor = conn.cursor()
    cursor.execute("SELECT points, energy, joined_channel FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    if not row:
    cursor.execute("INSERT INTO users (user_id, points, energy) VALUES (?, 0, 1000)", (user_id,))
conn.commit()
        row = (0, 1000, 0)
    conn.close()
    return row

def update_user_balance(user_id, points_delta=0, energy_delta=0):
    conn = sqlite3.connect('database.db')
    cursor = conn.cursor()
    cursor.execute("UPDATE users SET points = points + ?, energy = energy + ? WHERE user_id = ?", (points_delta, energy_delta, user_id))
    conn.commit()
    conn.close()

